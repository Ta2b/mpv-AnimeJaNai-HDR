+static const char *rife_policy_name(unsigned policy)
+{
+    return policy == AJI_RIFE_POLICY_QUALITY ? "quality" :
+           policy == AJI_RIFE_POLICY_FAST ? "fast" : "auto";
+}
+
+static bool check_rife_contract(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    if (!p->rife_on) { p->rife_semantics_state = "not-applicable"; return true; }
+#ifdef _WIN32
+    // This patch is installed by the Linux producer only. Do not make a future
+    // Windows source merge silently depend on an unported platform contract.
+    p->rife_semantics_state = "unsupported-platform";
+    return true;
+#else
+    // dlsym also searches dependencies: their contract cannot certify the
+    // selected shim's configuration or pixel implementation.
+    Dl_info engine = {0}, configuration = {0}, pixels = {0}, contract = {0};
+    bool same_image = p->api.rife_semantics &&
+        dladdr((void *)p->api.create, &engine) && engine.dli_fbase &&
+        dladdr((void *)p->api.configure, &configuration) &&
+        dladdr((void *)p->api.infer_rife, &pixels) &&
+        dladdr((void *)p->api.rife_semantics, &contract) &&
+        engine.dli_fbase == configuration.dli_fbase &&
+        engine.dli_fbase == pixels.dli_fbase && engine.dli_fbase == contract.dli_fbase;
+    int status = same_image ?
+        p->api.rife_semantics(p->aji, 1, &p->rife_semantics, sizeof(p->rife_semantics)) : -2;
+    if (status) {
+        memset(&p->rife_semantics, 0, sizeof(p->rife_semantics));
+        Dl_info image = {0};
+        if (dladdr((void *)p->api.create, &image) && image.dli_fname)
+            snprintf(p->rife_semantics.module_path, sizeof(p->rife_semantics.module_path), "%s", image.dli_fname);
+        p->rife_semantics_state = "unknown";
+        if (p->opts->rife_policy == AJI_RIFE_POLICY_FAST) {
+            MP_WARN(vf, "RIFE requested=fast effective=unknown contract=unavailable module=%s\n",
+                    p->rife_semantics.module_path);
+            return true;
+        }
+        p->rife_semantics_state = "failed";
+        MP_ERR(vf, "RIFE %s cannot be verified for loaded module %s (status %d). "
+                   "Update the player and GPU components, then restart. Local files were preserved.\n",
+               rife_policy_name(p->opts->rife_policy), p->rife_semantics.module_path, status);
+        return false;
+    }
+    int checked = aji_rife_semantics_check_v1(&p->rife_semantics, p->opts->rife_policy);
+    if (checked) {
+        p->rife_semantics_state = "failed";
+        MP_ERR(vf, "RIFE requested=%s has invalid or mismatched effective semantics (%d). "
+                   "Update the selected GPU engine; Quality is never replaced with Fast.\n",
+               rife_policy_name(p->opts->rife_policy), checked);
+        // Malformed strings must not be exported by GET_META either.
+        memset(&p->rife_semantics, 0, sizeof(p->rife_semantics));
+        return false;
+    }
+    p->rife_semantics_state = "verified";
+    MP_INFO(vf, "RIFE requested=%s effective=%s contract=v1 flags=%u module=%s declared_source=%s\n",
+            rife_policy_name(p->opts->rife_policy), rife_policy_name(p->rife_semantics.policy),
+            p->rife_semantics.flags, p->rife_semantics.module_path,
+            p->rife_semantics.flags & AJI_RIFE_SOURCE_DECLARED ? p->rife_semantics.source_revision : "unknown");
+    return true;
+#endif
+}
