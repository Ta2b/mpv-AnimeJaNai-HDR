+// While the ordered pipeline prepares its stages (engine builds on first play
+// included) and once it runs, its stages' configure logs replace the legacy
+// chain's stats snapshot: the engine monitor narrates the builds and holds
+// playback exactly as on the legacy route, and the stats overlay shows the
+// stages. Written only when the text changes; the module may lack the call.
+static void pipeline_publish_stats(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    if (!p->pipeline || !p->pipe.status_text || !p->path.stats) return;
+    char text[16384];
+    if (p->pipe.status_text(p->pipeline, text, sizeof(text)) != 0 || !text[0]) return;
+    if (p->pipeline_stats_text && strcmp(p->pipeline_stats_text, text) == 0) return;
+    talloc_free(p->pipeline_stats_text);
+    p->pipeline_stats_text = talloc_strdup(p, text);
+    if (!mp_save_to_file(p->path.stats, text, strlen(text)))
+        MP_WARN(vf, "Cannot publish stats snapshot %s\n", p->path.stats);
+}
