+// Submit an entire source pair before waiting for its last output. All reads
+// and writes use the same CUDA stream; source/interpolation refs stay alive.
+static void rife_burst_begin(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    mp_assert(!p->cuda_burst && !p->burst_refs_n && !p->ring_n);
+    p->burst_ticket = 0;
+    p->cuda_burst = !p->is_d3d11 && p->rife_first && p->aji_active;
+    if (!p->is_d3d11 && p->api.rife_begin_pair)
+        p->api.rife_begin_pair(p->aji, p->drawings ? 0 : p->rife_prev_serial, p->drawings ? 0 : p->rife_serial);
+}
+
+static bool rife_burst_end(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    bool ok = true;
+    if (p->cuda_burst) {
+        if (p->burst_ticket)
+            ok = p->api.wait(p->aji, p->burst_ticket) == AJI_OK;
+        // Include partially submitted work on an error path before dropping inputs.
+        drain_backend(vf);
+    }
+    p->cuda_burst = false;
+    p->burst_ticket = 0;
+    for (int i = 0; i < p->burst_refs_n; ++i) mp_image_unrefp(&p->burst_refs[i]);
+    p->burst_refs_n = 0;
+    return ok;
+}
