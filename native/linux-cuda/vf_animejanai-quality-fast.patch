+// Submit an entire source pair before waiting for its last output. All reads
+// and writes use the same CUDA stream; source/interpolation refs stay alive.
+static uint64_t rife_next_identity(struct priv *p)
+{
+    ++p->rife_next_id;
+    if (!p->rife_next_id) ++p->rife_next_id;
+    return p->rife_next_id;
+}
+
+static uint64_t rife_work_identity(struct priv *p, struct mp_image *frame)
+{
+    if (!frame) return 0;
+    for (int i = 0; i < MP_ARRAY_SIZE(p->wcache); ++i)
+        if (p->wcache[i].work && p->wcache[i].work->planes[0] == frame->planes[0] &&
+            p->wcache[i].pts == frame->pts) return p->wcache[i].id;
+    return 0; // not retained in this cache: conservatively avoid reuse across bursts
+}
+
+static void rife_burst_begin(struct mp_filter *vf, struct mp_image *left, struct mp_image *right)
+{
+    struct priv *p = vf->priv;
+    mp_assert(!p->cuda_burst && !p->burst_refs_n && !p->ring_n);
+    p->burst_ticket = 0;
+    const char *burst = getenv("AJI_RIFE_BURST");
+    p->cuda_burst = !p->is_d3d11 && p->rife_first && p->aji_active && !(burst && *burst == '0');
+    if (!p->is_d3d11 && p->api.rife_begin_pair)
+        p->api.rife_begin_pair(p->aji, p->drawings ? rife_work_identity(p, left) : p->rife_prev_serial,
+                               p->drawings ? rife_work_identity(p, right) : p->rife_serial);
+}
+
+static bool rife_burst_end(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    bool ok = true;
+    if (p->cuda_burst) {
+        if (p->burst_ticket)
+            ok = p->api.wait(p->aji, p->burst_ticket) == AJI_OK;
+        // Failed producers drain their partial work before returning. A normal
+        // last-output ticket already covers every earlier read on this stream.
+        if (!p->burst_ticket || !ok) drain_backend(vf);
+    }
+    p->cuda_burst = false;
+    p->burst_ticket = 0;
+    for (int i = 0; i < p->burst_refs_n; ++i) mp_image_unrefp(&p->burst_refs[i]);
+    p->burst_refs_n = 0;
+    return ok;
+}
