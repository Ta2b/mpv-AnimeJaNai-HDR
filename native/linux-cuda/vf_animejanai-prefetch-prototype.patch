+// Opt-in architecture prototype: a native-frame FIFO asks the unchanged
+// inference child for future frames even when presentation stops requesting.
+// All filters share the core graph thread; no transport/import or pixel copy.
+struct prefetch_priv {
+    struct mp_filter *backend;
+    struct mp_async_queue *queue;
+    int capacity;
+    bool resume_pending;
+    uint64_t produced, epoch;
+    int last_imgfmt;
+};
+struct prefetch_tap { struct prefetch_priv *owner; };
+
+static void prefetch_tap_process(struct mp_filter *f)
+{
+    struct prefetch_priv *p = ((struct prefetch_tap *)f->priv)->owner;
+    if (!mp_pin_in_needs_data(f->ppins[1]) ||
+        !mp_pin_out_request_data(f->ppins[0]))
+        return;
+    struct mp_frame frame = mp_pin_out_read(f->ppins[0]);
+    if (frame.type == MP_FRAME_VIDEO) {
+        struct mp_image *image = frame.data;
+        p->produced++;
+        p->last_imgfmt = image->imgfmt;
+    }
+    mp_pin_in_write(f->ppins[1], frame);
+}
+static const struct mp_filter_info prefetch_tap_info = {
+    .name = "animejanai_prefetch_tap",
+    .priv_size = sizeof(struct prefetch_tap),
+    .process = prefetch_tap_process,
+};
+static void prefetch_process(struct mp_filter *f)
+{
+    struct prefetch_priv *p = f->priv;
+    if (p->queue && p->resume_pending) {
+        p->resume_pending = false;
+        // Resume after the complete graph reset, not between child resets.
+        mp_async_queue_resume_reading(p->queue);
+    }
+}
+static void prefetch_reset(struct mp_filter *f)
+{
+    struct prefetch_priv *p = f->priv;
+    if (p->queue)
+        mp_async_queue_reset(p->queue);
+    p->epoch++;
+    p->last_imgfmt = 0;
+    p->resume_pending = p->queue != NULL;
+    mp_filter_wakeup(f);
+}
+static void prefetch_destroy(struct mp_filter *f)
+{
+    struct prefetch_priv *p = f->priv;
+    if (p->queue)
+        mp_async_queue_reset(p->queue);
+}
+static bool prefetch_command(struct mp_filter *f, struct mp_filter_command *cmd)
+{
+    struct prefetch_priv *p = f->priv;
+    if (cmd->type == MP_FILTER_COMMAND_GET_META) {
+        struct mp_tags *tags = talloc_zero(NULL, struct mp_tags);
+        char text[64];
+        snprintf(text, sizeof(text), "%d", p->capacity);
+        mp_tags_set_str(tags, "prefetch-capacity", text);
+        snprintf(text, sizeof(text), "%"PRId64, p->queue ? mp_async_queue_get_samples(p->queue) : 0);
+        mp_tags_set_str(tags, "prefetch-ready", text);
+        snprintf(text, sizeof(text), "%"PRIu64, p->produced);
+        mp_tags_set_str(tags, "prefetch-produced", text);
+        snprintf(text, sizeof(text), "%"PRIu64, p->epoch);
+        mp_tags_set_str(tags, "prefetch-epoch", text);
+        mp_tags_set_str(tags, "prefetch-format", p->last_imgfmt ? mp_imgfmt_to_name(p->last_imgfmt) : "unknown");
+        *(struct mp_tags **)cmd->res = tags;
+        return true;
+    }
+    // A slot change needs media-position/generation policy (PLY-07); do not
+    // return old precomputed pictures as if they belonged to a new slot.
+    if (p->queue && cmd->type == MP_FILTER_COMMAND_TEXT && cmd->cmd &&
+        strcmp(cmd->cmd, "slot") == 0)
+        return false;
+    return mp_filter_command(p->backend, cmd);
+}
+static const struct mp_filter_info prefetch_info = {
+    .name = "animejanai_prefetch",
+    .priv_size = sizeof(struct prefetch_priv),
+    .process = prefetch_process,
+    .reset = prefetch_reset,
+    .destroy = prefetch_destroy,
+    .command = prefetch_command,
+};
+static struct mp_filter *vf_animejanai_create(struct mp_filter *parent, void *options)
+{
+    struct opts *opts = options;
+    struct mp_filter *f = mp_filter_create(parent, &prefetch_info);
+    if (!f) { talloc_free(options); return NULL; }
+    struct prefetch_priv *p = f->priv;
+    p->capacity = opts->prefetch;
+    if (p->capacity)
+        p->queue = talloc_steal(p, mp_async_queue_create());
+    mp_filter_add_pin(f, MP_PIN_IN, "in");
+    mp_filter_add_pin(f, MP_PIN_OUT, "out");
+    p->backend = vf_animejanai_create_backend(f, options);
+    if (!p->backend) { talloc_free(f); return NULL; }
+    struct mp_filter *tap = mp_filter_create(f, &prefetch_tap_info);
+    if (!tap) { talloc_free(f); return NULL; }
+    mp_filter_add_pin(tap, MP_PIN_IN, "in");
+    mp_filter_add_pin(tap, MP_PIN_OUT, "out");
+    ((struct prefetch_tap *)tap->priv)->owner = p;
+    mp_pin_connect(p->backend->pins[0], f->ppins[0]);
+    mp_pin_connect(tap->pins[0], p->backend->pins[1]);
+    if (p->queue) {
+        struct mp_filter *writer = mp_async_queue_create_filter(f, MP_PIN_IN, p->queue);
+        struct mp_filter *reader = mp_async_queue_create_filter(f, MP_PIN_OUT, p->queue);
+        if (!writer || !reader) { talloc_free(f); return NULL; }
+        mp_async_queue_set_config(p->queue, (struct mp_async_queue_config){
+            .max_samples = p->capacity, .max_bytes = INT64_MAX,
+        });
+        mp_pin_connect(writer->pins[0], tap->pins[1]);
+        mp_pin_connect(f->ppins[1], reader->pins[0]);
+        p->resume_pending = true;
+        mp_filter_wakeup(f);
+    } else {
+        // The off path only observes already requested frames; it cannot pull
+        // sources without downstream demand, so it is a usable ablation.
+        mp_pin_connect(f->ppins[1], tap->pins[1]);
+    }
+    return f;
+}
