+// The worker publishes terminal state before this callback; waking a filter is
+// the only graph operation allowed from a foreign thread.
+static void surface_worker_wakeup(void *opaque)
+{
+    mp_filter_wakeup(opaque);
+}
+
+struct surface_frame_owner {
+    atomic_uint refs;
+    struct priv *filter;
+    struct mp_image *image;
+};
+static struct surface_frame_owner *surface_owner_new(struct priv *p, struct mp_image *image)
+{
+    struct surface_frame_owner *owner = malloc(sizeof(*owner));
+    if (!owner) return NULL;
+    atomic_init(&owner->refs, 1);
+    owner->filter = p;
+    owner->image = mp_image_new_ref(image);
+    if (!owner->image) { free(owner); return NULL; }
+    atomic_fetch_add(&p->worker_live_owners, 1);
+    return owner;
+}
+static void surface_owner_drop(struct surface_frame_owner *owner)
+{
+    if (atomic_fetch_sub_explicit(&owner->refs, 1, memory_order_acq_rel) == 1) {
+        atomic_fetch_sub(&owner->filter->worker_live_owners, 1);
+        mp_image_unrefp(&owner->image);
+        free(owner);
+    }
+}
+static void surface_owner_retain(void *opaque)
+{
+    struct surface_frame_owner *owner = opaque;
+    atomic_fetch_add_explicit(&owner->refs, 1, memory_order_relaxed);
+    atomic_fetch_add(&owner->filter->worker_retains, 1);
+}
+static void surface_owner_release(void *opaque)
+{
+    struct surface_frame_owner *owner = opaque;
+    atomic_fetch_add(&owner->filter->worker_releases, 1);
+    surface_owner_drop(owner);
+}
+static int surface_format(int fmt)
+{
+    return fmt == AJI_FMT_NV12 ? AJI_SURFACE_NV12 :
+           fmt == AJI_FMT_P010 ? AJI_SURFACE_P010 :
+           fmt == AJI_FMT_YUV444P16 ? AJI_SURFACE_YUV444P16 : 0;
+}
+static aji_surface_color_v1 surface_color(struct mp_image_params *params, int format)
+{
+    aji_surface_color_v1 color = {
+        .matrix = map_matrix(params) + 1,
+        .range = map_range(params) == AJI_RANGE_FULL ? AJI_SURFACE_RANGE_FULL : AJI_SURFACE_RANGE_LIMITED,
+        .siting = map_siting(params),
+        .component_bits = format == AJI_SURFACE_NV12 ? 8 : format == AJI_SURFACE_P010 ? 10 : 16,
+        .quantization = AJI_SURFACE_QUANT_REFERENCE_NATIVE_YUV,
+        .dither = AJI_SURFACE_DITHER_NONE,
+    };
+    switch (params->color.primaries) {
+    case PL_COLOR_PRIM_BT_709: color.primaries = AJI_SURFACE_PRIM_709; break;
+    case PL_COLOR_PRIM_BT_2020: color.primaries = AJI_SURFACE_PRIM_2020; break;
+    case PL_COLOR_PRIM_DCI_P3:
+    case PL_COLOR_PRIM_DISPLAY_P3: color.primaries = AJI_SURFACE_PRIM_P3; break;
+    case PL_COLOR_PRIM_BT_601_525:
+    case PL_COLOR_PRIM_BT_601_625: color.primaries = AJI_SURFACE_PRIM_601; break;
+    }
+    switch (params->color.transfer) {
+    case PL_COLOR_TRC_BT_1886: color.transfer = AJI_SURFACE_TRC_1886; break;
+    case PL_COLOR_TRC_SRGB: color.transfer = AJI_SURFACE_TRC_SRGB; break;
+    }
+    return color;
+}
+static bool surface_worker_descriptor(struct priv *p, struct mp_image *image,
+                                      int format, struct surface_frame_owner *owner,
+                                      uint64_t sequence, aji_surface_v1 *out)
+{
+    if (!format || image->w <= 0 || image->h <= 0) return false;
+    *out = (aji_surface_v1){
+        .struct_size = sizeof(*out), .version = 1,
+        .resource_kind = AJI_RESOURCE_CUDA, .device_kind = AJI_RESOURCE_CUDA,
+        .device_index = p->worker_device, .device_context = p->cuda_ctx,
+        .format = format, .width = image->w, .height = image->h,
+        .crop = {0, 0, image->w, image->h},
+        .plane_count = format == AJI_SURFACE_YUV444P16 ? 3 : 2,
+        .rotation = image->params.rotate,
+        .color = surface_color(&image->params, format),
+        .sequence = sequence, .generation = p->worker_generation,
+        .owner = owner, .retain = surface_owner_retain, .release = surface_owner_release,
+    };
+    if (image->pts != MP_NOPTS_VALUE && isfinite(image->pts) &&
+        fabs(image->pts) < (double)INT64_MAX / 1000000000) {
+        out->time_flags = AJI_SURFACE_HAS_PTS;
+        out->pts = llrint(image->pts * 1000000000);
+        out->timebase_num = 1; out->timebase_den = 1000000000;
+    }
+    int bpp = format == AJI_SURFACE_NV12 ? 1 : 2;
+    for (int i = 0; i < out->plane_count; i++) {
+        int rows = mp_image_plane_h(image, i);
+        if (!image->planes[i] || image->stride[i] <= 0 || rows <= 0) return false;
+        out->planes[i] = (aji_surface_plane_v1){
+            .data = image->planes[i], .row_stride = image->stride[i],
+            .bytes = (uint64_t)(rows - 1) * image->stride[i] + (uint64_t)image->w * bpp,
+        };
+    }
+    return true;
+}
+static void surface_worker_try_enable(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    if (p->worker_fatal || p->worker_attempted || !p->opts->surface_worker) return;
+    p->worker_attempted = true;
+    p->worker_reason = "unsupported-chain";
+    if (!p->aji || !p->aji_active || p->is_d3d11 || p->rife_on || p->temporal_r ||
+        p->has_pre_resize || p->drawings) return;
+    p->worker_reason = "missing-surface-api";
+    if (!p->api.surface_query || !p->api.async_query || !p->api.async_enable ||
+        !p->api.async_disable || !p->api.surface_submit || !p->api.surface_complete ||
+        !p->api.surface_drain || !p->api.surface_wakeup) return;
+    p->worker_reason = "decode-events-unavailable";
+    if (!p->decode_evt_ok) return;
+    int input_format = surface_format(p->aji_fmt), output_format = surface_format(p->out_fmt);
+    aji_surface_color_v1 color = surface_color(&p->params, input_format);
+    p->worker_reason = "unsupported-color-format";
+    if (!input_format || !output_format || !color.primaries || !color.transfer ||
+        color.siting != AJI_SURFACE_SITING_LEFT || p->params.rotate < 0 ||
+        p->params.rotate >= 360 || p->params.rotate % 90) return;
+    aji_surface_caps_v1 caps;
+    aji_surface_async_caps_v1 async;
+    p->worker_reason = "capability-negotiation-rejected";
+    if (p->api.surface_query(p->aji, 1, &caps, sizeof(caps)) != AJI_SURFACE_OK ||
+        p->api.async_query(p->aji, 1, &async, sizeof(async)) != AJI_SURFACE_OK ||
+        !(caps.flags & AJI_SURFACE_SPATIAL) || caps.device_kind != AJI_RESOURCE_CUDA ||
+        async.device_kind != AJI_RESOURCE_CUDA || !async.max_capacity ||
+        !(caps.resource_mask & (1ull << AJI_RESOURCE_CUDA)) ||
+        !(caps.format_mask & (1ull << input_format)) || !(caps.format_mask & (1ull << output_format)) ||
+        !(async.dependency_mask & (1ull << AJI_SURFACE_DEP_CUDA_EVENT))) return;
+    p->worker_device = caps.device_index;
+    p->depth = MPMIN(p->depth, async.max_capacity);
+    mp_refqueue_set_refs(p->queue, 0, p->depth - 1);
+    p->worker_reason = "wakeup-registration-rejected";
+    if (p->api.surface_wakeup(p->aji, surface_worker_wakeup, vf) != AJI_SURFACE_OK) return;
+    p->worker_reason = "enable-failed";
+    if (p->api.async_enable(p->aji, p->depth) != AJI_SURFACE_OK) {
+        p->api.surface_wakeup(p->aji, NULL, NULL); return;
+    }
+    p->worker_active = true;
+    p->worker_reason = "active";
+    MP_VERBOSE(vf, "Surface CUDA worker active: %d job slots, native NVDEC dependencies\n", p->depth);
+}
