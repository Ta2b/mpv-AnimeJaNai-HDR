+static struct mp_image *alloc_out(struct mp_filter *vf);
+static bool pipeline_requested(struct priv *p)
+{
+    if (!p->path.conf || p->pending_slot < 1) return false;
+    FILE *file = fopen(p->path.conf, "r");
+    if (!file) return false;
+    char line[8192]; int slot = -1; bool found = false;
+    while (fgets(line, sizeof(line), file)) {
+        char *s = line;
+        while (*s == ' ' || *s == '\t') s++;
+        for (char *c = s; *c; c++) if (*c >= 'A' && *c <= 'Z') *c += 'a' - 'A';
+        if (*s == '[') { slot = -1; sscanf(s, "[slot_%d]", &slot); }
+        if (slot == p->pending_slot && strncmp(s, "chain_", 6) == 0 &&
+            strstr(s, "_pipeline_version") && strchr(s, '=')) { found = true; break; }
+    }
+    fclose(file); return found;
+}
+static char *pipeline_sibling(struct priv *p, const char *name)
+{
+    const char *lib = p->path.lib ? p->path.lib : AJI_DEFAULT_LIB;
+    const char *slash = strrchr(lib, '/');
+    return slash ? talloc_asprintf(p, "%.*s/%s", (int)(slash-lib), lib, name) : talloc_strdup(p, name);
+}
+static void pipeline_stop(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    if (p->pipeline) { p->pipe.destroy(p->pipeline); p->pipeline = NULL; }
+    for (int i = 0; i < p->pipeline_n; i++) mp_image_unrefp(&p->pipeline_images[i]);
+    p->pipeline_n = 0; p->pipeline_ticket = 0; p->pipeline_ready = false;
+    if (p->pipeline_event && p->cu && p->cuda_ctx &&
+        p->cu->cuCtxPushCurrent(p->cuda_ctx) == CUDA_SUCCESS) {
+        CUcontext previous; p->cu->cuEventDestroy(p->pipeline_event);
+        p->cu->cuCtxPopCurrent(&previous);
+    }
+    p->pipeline_event = NULL;
+}
+static bool pipeline_start(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    bool had_pipeline = p->pipeline != NULL;
+    bool requested = pipeline_requested(p);
+    pipeline_stop(vf);
+    if (had_pipeline || requested) {
+        for (int i = 0; i < p->outq_n; i++) mp_image_unrefp(&p->outq[p->outq_pos+i]);
+        p->outq_n = p->outq_pos = 0;
+        mp_image_unrefp(&p->rife_prev);
+    }
+    if (!requested) return true;
+    if (p->is_d3d11 || !p->cuda_ctx || !isfinite(p->fps) || p->fps <= 0) {
+        MP_ERR(vf, "Ordered interpolation requires Linux CUDA and a known positive source cadence\n");
+        return false;
+    }
+    if (!p->pipe.handle) {
+        const char *path = p->path.pipeline_lib ? p->path.pipeline_lib : pipeline_sibling(p, "libaji_pipeline.so");
+        p->pipe.handle = aji_lib_open(path);
+        if (!p->pipe.handle) { MP_ERR(vf, "Ordered interpolation module missing: %s: %s\n", path, aji_lib_error()); return false; }
+#define PIPE_SYM(field, name) do { p->pipe.field = aji_lib_sym(p->pipe.handle, name); if (!p->pipe.field) { MP_ERR(vf, "Missing ordered pipeline API: %s\n", name); return false; } } while (0)
+        PIPE_SYM(create, "aji_pipeline_create_v1"); PIPE_SYM(query, "aji_pipeline_query_v1");
+        PIPE_SYM(submit, "aji_pipeline_submit_v1"); PIPE_SYM(complete, "aji_pipeline_complete_v1");
+        PIPE_SYM(error, "aji_pipeline_last_error_v1"); PIPE_SYM(destroy, "aji_pipeline_destroy_v1");
+        PIPE_SYM(stats, "aji_pipeline_stats_v1_get");
+#undef PIPE_SYM
+    }
+    CUcontext previous; CUdevice device;
+    if (CHECK_CU(p->cu->cuCtxPushCurrent(p->cuda_ctx)) < 0) return false;
+    bool ok = CHECK_CU(p->cu->cuCtxGetDevice(&device)) >= 0 &&
+              CHECK_CU(p->cu->cuEventCreate(&p->pipeline_event, CU_EVENT_DISABLE_TIMING)) >= 0;
+    p->cu->cuCtxPopCurrent(&previous); if (!ok) return false;
+    p->worker_device = device;
+    AVRational fps = av_d2q(p->fps, 1000000);
+    char *env = p->path.trtexec_libdir ? talloc_asprintf(p, "LD_LIBRARY_PATH=%s", p->path.trtexec_libdir) : NULL;
+    aji_pipeline_create_v1_params params = {
+        .struct_size = sizeof(params), .version = 1,
+        .width = p->params.w, .height = p->params.h, .device_index = device,
+        .slot = p->pending_slot, .capacity = 1, .flags = 1,
+        .generation = p->worker_generation, .cuda_context = p->cuda_ctx,
+        .conf = p->path.conf, .model_dir = p->path.model_dir, .rife_dir = p->path.rife_model_dir,
+        .trtexec = p->path.trtexec, .trtexec_env = env,
+        .trt_library = pipeline_sibling(p, "libaji_trt.so"),
+        .kernel_fatbin = p->path.pipeline_kernels ? p->path.pipeline_kernels : pipeline_sibling(p, "aji_pipeline.fatbin"),
+        .fps_numerator = fps.num, .fps_denominator = fps.den,
+        .wakeup = surface_worker_wakeup, .wakeup_opaque = vf,
+    };
+    char message[1024] = {0};
+    int code = p->pipe.create(&params, &p->pipeline, message, sizeof(message));
+    if (code == AJI_PIPELINE_LEGACY) { pipeline_stop(vf); return true; }
+    if (code) { MP_ERR(vf, "Ordered pipeline rejected: %s (%d)\n", message, code); pipeline_stop(vf); return false; }
+    p->cur_slot = p->pending_slot; p->rife_on = p->rife_first = p->drawings = false;
+    p->has_pre_resize = false; p->temporal_r = 0; p->depth = 1;
+    mp_refqueue_set_refs(p->queue, 0, 1);
+    MP_VERBOSE(vf, "Ordered GPU pipeline initializing on its worker\n"); return true;
+}
+static void pipeline_process(struct mp_filter *vf)
+{
+    struct priv *p = vf->priv;
+    if (!p->pipeline_ready) {
+        aji_pipeline_caps_v1 caps;
+        int status = p->pipe.query(p->pipeline, &caps, sizeof(caps));
+        if (status == AJI_SURFACE_ASYNC_BUSY) return;
+        if (status) {
+            char message[1024]; p->pipe.error(p->pipeline, message, sizeof(message));
+            MP_ERR(vf, "Ordered pipeline initialization failed: %s\n", message); goto fail;
+        }
+        if (caps.factor < 1 || caps.factor > AJI_PIPELINE_MAX_OUTPUTS || caps.output_format != AJI_SURFACE_YUV444P16) goto fail;
+        p->pipeline_caps = caps; p->pipeline_ready = true;
+        double sx = (double)caps.width / p->params.w, sy = (double)caps.height / p->params.h;
+        p->out_params = p->params; p->out_params.w = caps.width; p->out_params.h = caps.height;
+        p->out_params.crop.x0 = lrint(p->params.crop.x0*sx); p->out_params.crop.y0 = lrint(p->params.crop.y0*sy);
+        p->out_params.crop.x1 = lrint(p->params.crop.x1*sx); p->out_params.crop.y1 = lrint(p->params.crop.y1*sy);
+        p->out_params.hw_subfmt = pixfmt2imgfmt(AV_PIX_FMT_YUV444P16);
+        p->out_params.repr.bits = (struct pl_bit_encoding){.sample_depth=16,.color_depth=16,.bit_shift=0};
+        p->out_params.chroma_location = PL_CHROMA_LEFT; p->out_fmt = AJI_FMT_YUV444P16;
+        MP_VERBOSE(vf, "Ordered GPU pipeline active: %u stages, x%u, %ux%u, %s\n", caps.stage_count, caps.factor,
+            caps.width, caps.height, caps.flags&AJI_INTERPOLATOR_FAST ? "Fast" : "Quality");
+    }
+    if (p->pipeline_ticket) {
+        aji_pipeline_completion_v1 done;
+        int status = p->pipe.complete(p->pipeline, p->pipeline_ticket, AJI_SURFACE_CONSUME_RESULT, &done, sizeof(done));
+        if (!status && done.result.state == AJI_SURFACE_PENDING) return;
+        if (status || done.result.state != AJI_SURFACE_FINISHED) {
+            MP_ERR(vf, "Ordered pipeline execution failed: %s (%d)\n", status ? "completion rejected" : done.result.message, status); goto fail;
+        }
+        p->pipeline_ticket = 0;
+        for (int i = 0; i < p->pipeline_n; i++)
+            MP_DBG(vf, "Ordered output pts=%.12f duration=%.12f provenance=%u\n", p->pipeline_images[i]->pts,
+                   p->pipeline_images[i]->pkt_duration, done.output_flags[i]);
+        struct mp_image *first = p->pipeline_images[0]; p->pipeline_images[0] = NULL;
+        for (int i = 1; i < p->pipeline_n; i++) { p->outq[p->outq_n++] = p->pipeline_images[i]; p->pipeline_images[i] = NULL; }
+        p->outq_pos = 0; p->pipeline_n = 0; p->pipeline_source_sequence++; p->worker_completed++;
+        mp_refqueue_write_out_pin(p->queue, first); return;
+    }
+    if (!mp_refqueue_can_output(p->queue)) return;
+    struct mp_image *left = mp_refqueue_get(p->queue, 0), *right = mp_refqueue_get(p->queue, 1);
+    bool eof = right == NULL;
+    if (!left) return;
+    struct surface_frame_owner *owners[2+AJI_PIPELINE_MAX_OUTPUTS] = {0};
+    aji_surface_v1 inputs[2], outputs[AJI_PIPELINE_MAX_OUTPUTS];
+    struct mp_image *sources[2] = {left, right};
+    int input_count = eof ? 1 : 2, count = eof ? 1 : p->pipeline_caps.factor;
+    bool valid = true;
+    for (int i = 0; i < input_count; i++) {
+        owners[i] = surface_owner_new(p, sources[i]);
+        valid = valid && owners[i] && surface_worker_descriptor(p, sources[i], surface_format(p->aji_fmt), owners[i], p->pipeline_source_sequence+i+1, &inputs[i]);
+        if (valid) {
+            double duration = sources[i]->pkt_duration > 0 ? sources[i]->pkt_duration : 1/p->fps;
+            inputs[i].duration = llrint(duration*1000000000); inputs[i].time_flags |= AJI_SURFACE_HAS_DURATION;
+        }
+    }
+    long double interval = valid && !eof ? (long double)inputs[1].pts-inputs[0].pts : valid ? inputs[0].duration : 0;
+    for (int i = 0; i < count && valid; i++) {
+        struct mp_image *out = alloc_out(vf); if (!out) { valid = false; break; }
+        p->pipeline_images[p->pipeline_n++] = out; mp_image_copy_attributes(out, left); out->params = p->out_params;
+        int64_t pts = inputs[0].pts + llroundl(interval*i/count), duration = llroundl(interval/count);
+        out->pts = (double)pts/1000000000; out->pkt_duration = (double)duration/1000000000;
+        out->nominal_fps = p->fps*p->pipeline_caps.factor;
+        owners[2+i] = surface_owner_new(p, out);
+        valid = owners[2+i] && surface_worker_descriptor(p, out, AJI_SURFACE_YUV444P16, owners[2+i], ++p->worker_sequence, &outputs[i]);
+        if (valid) { outputs[i].pts = pts; outputs[i].duration = duration; outputs[i].time_flags = 3; }
+    }
+    aji_pipeline_submit_v1_request request = {
+        .struct_size = sizeof(request), .version = 1, .flags = eof ? AJI_PIPELINE_EOF : 0,
+        .generation = p->worker_generation, .output_count = count,
+        .previous = eof ? NULL : &inputs[0], .current = &inputs[eof ? 0 : 1],
+        .dependency_count = 1, .dependencies = {{.kind=AJI_SURFACE_DEP_CUDA_EVENT,.event=p->pipeline_event}},
+    };
+    for (int i = 0; i < count; i++) request.outputs[i] = &outputs[i];
+    CUcontext previous;
+    if (valid && CHECK_CU(p->cu->cuCtxPushCurrent(p->cuda_ctx)) >= 0) {
+        valid = CHECK_CU(p->cu->cuEventRecord(p->pipeline_event, p->decode_stream)) >= 0;
+        p->cu->cuCtxPopCurrent(&previous);
+    } else valid = false;
+    int status = valid ? p->pipe.submit(p->pipeline, &request, &p->pipeline_ticket) : AJI_SURFACE_INVALID;
+    for (int i = 0; i < 2+AJI_PIPELINE_MAX_OUTPUTS; i++) if (owners[i]) surface_owner_drop(owners[i]);
+    if (status || !p->pipeline_ticket) { MP_ERR(vf, "Ordered pipeline submission rejected (%d): verify native format/color/PTS\n", status); goto fail; }
+    p->worker_submitted++; return;
+fail:
+    pipeline_stop(vf); p->worker_fatal = true; mp_filter_internal_mark_failed(vf);
+}
