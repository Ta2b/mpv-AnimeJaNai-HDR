+
+static uint64_t prefetch_add_size(uint64_t a, uint64_t b)
+{
+    const uint64_t limit = INT64_MAX / 4;
+    return a >= limit || b >= limit - a ? limit : a + b;
+}
+
+// CUDA AVBuffer sizes include allocator padding when available. Plane pitches
+// provide a conservative payload fallback for handle-only buffer references.
+// Count owned references conservatively; shared buffers may be charged twice.
+static uint64_t prefetch_frame_size(struct mp_frame frame)
+{
+    if (frame.type != MP_FRAME_VIDEO)
+        return 0;
+    struct mp_image *image = frame.data;
+    uint64_t allocation = sizeof(*image), payload = sizeof(*image);
+    for (int n = 0; n < MP_MAX_PLANES; n++) {
+        if (image->bufs[n])
+            allocation = prefetch_add_size(allocation, image->bufs[n]->size);
+        if (n < image->num_planes && image->planes[n]) {
+            int64_t pitch = image->stride[n];
+            if (pitch < 0) pitch = -pitch;
+            int height = mp_image_plane_h(image, n);
+            if (height > 0)
+                payload = prefetch_add_size(payload, (uint64_t)pitch * height);
+        }
+    }
+    return MPMAX(allocation, payload);
+}
