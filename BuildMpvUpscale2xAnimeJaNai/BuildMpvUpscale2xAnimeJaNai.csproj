<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\tools\interpolation\*.py;..\tools\interpolation\*.json" Link="mpv-upscale-2x_animejanai\animejanai\preparation\%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
    <None Include="..\docs\LINUX*.md" Link="linux-docs\%(Filename)%(Extension)">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\docs\INTERPOLATION-STAGES.md" Link="mpv-upscale-2x_animejanai\docs\INTERPOLATION-STAGES.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\docs\SETTINGS.md" Link="mpv-upscale-2x_animejanai\docs\SETTINGS.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="mpv-upscale-2x_animejanai\**\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SevenZipExtractor" Version="1.0.19" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../windows-mpv-source-ref.txt" Condition="Exists('../windows-mpv-source-ref.txt')" Link="windows-mpv-source-ref.txt" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
    <Content Include="../manager-source-ref.txt" Link="manager-source-ref.txt" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
