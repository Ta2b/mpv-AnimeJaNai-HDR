+// The internal Surface RIFE-first Quality route already crops its quantized
+// YUV prediction into temporary 0. Use that stable allocation for the spatial
+// graph too: endpoints are copied there, intermediate pictures are already
+// there. The Surface caller owns its lifetime and drains allocation errors.
+static bool rife_quality_graph_input(aji_ctx *c, const aji_frame *in, aji_frame *staged)
+{
+    const char *setting = std::getenv("AJI_RIFE_YUV_STAGING");
+    if (!c->surface.dispatch || !c->rife.enabled || !c->rife.before_upscale ||
+        c->conf.rife_warp || c->temporal.enabled || c->has_pre_resize || c->rtx.active ||
+        in->width != c->rife.w || in->height != c->rife.h ||
+        (setting && *setting == '0'))
+        return false;
+    *staged = cuda_surface_temporary(c, 0, *in, in->width, in->height);
+    return true;
+}
