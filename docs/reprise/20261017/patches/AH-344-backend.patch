@@ -0,0 +1,69 @@
+#include "rife_pair_cache.h"
+#include <cassert>
+#include <cstdio>
+#include <utility>
+#include <initializer_list>
+
+int main()
+{
+    int storage[4] = {};
+    aji_frame a{}, b{};
+    a.width = b.width = 1280; a.height = b.height = 720;
+    a.format = b.format = AJI_FMT_P010;
+    a.matrix = b.matrix = AJI_MATRIX_BT709;
+    a.range = b.range = AJI_RANGE_LIMITED;
+    a.siting = b.siting = AJI_SITING_LEFT;
+    a.plane[0] = &storage[0]; b.plane[0] = &storage[1];
+    a.stride[0] = b.stride[0] = 2560;
+    aji_frame other_slice = a;
+    assert(dml_same_texture_slice(a, other_slice));
+    other_slice.plane[1] = reinterpret_cast<void *>(1);
+    assert(!dml_same_texture_slice(a, other_slice));
+    assert(!dml_same_texture_slice(aji_frame{}, aji_frame{}));
+    RifePairCache pair;
+    pair.remember(a, b, false);
+    assert(!pair.matches(a, b)); // unannounced / old filter
+    for (auto ids : {std::pair<uint64_t,uint64_t>{0,2}, {1,0}, {0,0}}) {
+        pair.begin(ids.first, ids.second); pair.remember(a, b, false);
+        assert(!pair.matches(a, b));
+    }
+    pair.begin(11, 12, false); pair.remember(a, b, false);
+    assert(!pair.matches(a, b)); // ablation remains uncached
+    pair.begin(11, 12);
+    assert(!pair.matches(a, b)); // partial preparation not committed
+    pair.remember(a, b, false);
+    assert(pair.matches(a, b) && !pair.scene);
+    for (int side = 0; side < 2; ++side) {
+        for (int field = 0; field < 12; ++field) {
+            aji_frame frames[2] = {a,b}; auto &changed = frames[side];
+            switch (field) {
+            case 0: ++changed.width; break;
+            case 1: ++changed.height; break;
+            case 2: ++changed.format; break;
+            case 3: ++changed.matrix; break;
+            case 4: ++changed.range; break;
+            case 5: ++changed.siting; break;
+            default:
+                if (field < 9) changed.plane[field-6] = &storage[3];
+                else ++changed.stride[field-9];
+            }
+            assert(!pair.matches(frames[0], frames[1]));
+        }
+    }
+    pair.begin(11, 12); // reused addresses/IDs in a NEW burst are not enough
+    assert(!pair.matches(a, b));
+    pair.remember(a, b, true);
+    assert(pair.matches(a, b) && pair.scene);
+    {
+        RifePairFailureGuard failed{pair};
+    }
+    assert(!pair.matches(a, b) && !pair.enabled());
+    pair.begin(21, 22); pair.remember(a, b, false);
+    {
+        RifePairFailureGuard success{pair}; success.complete = true;
+    }
+    assert(pair.matches(a, b));
+    pair.clear(); // seek/configure/model reset uses this production state
+    assert(!pair.matches(a, b) && !pair.enabled());
+    std::puts("PASS: no-ID/off, both 12-field views, burst lifetime, cut, failure and reset");
+}
