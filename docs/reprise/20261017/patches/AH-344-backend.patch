+++ b/src/rife_pair_cache.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include "frame_identity.h"
+
+// D3D11 array textures may hold independent frame slices. Reject an output
+// writing the actual source slice, without disabling reuse for other slices.
+inline bool dml_same_texture_slice(const aji_frame &a, const aji_frame &b)
+{
+    return a.plane[0] && a.plane[0] == b.plane[0] && a.plane[1] == b.plane[1];
+}
+
+// One explicitly delimited immutable pair, not an address-keyed image cache.
+// begin() always ends the previous burst, even when the caller repeats IDs.
+// No identities / no extension call means the old uncached path.
+struct RifePairCache {
+    uint64_t left_id = 0, right_id = 0;
+    SourceView source[2];
+    bool ready = false, scene = false;
+
+    void clear() { *this = {}; }
+    void begin(uint64_t left, uint64_t right, bool enabled = true) {
+        clear();
+        if (enabled && left && right) { left_id = left; right_id = right; }
+    }
+    bool enabled() const { return left_id && right_id; }
+    bool matches(const aji_frame &a, const aji_frame &b) const {
+        return ready && source[0].matches(left_id, a, nullptr)
+            && source[1].matches(right_id, b, nullptr);
+    }
+    void remember(const aji_frame &a, const aji_frame &b, bool is_scene) {
+        ready = enabled();
+        if (ready) {
+            source[0] = {left_id, a, nullptr};
+            source[1] = {right_id, b, nullptr};
+            scene = is_scene;
+        }
+    }
+};
+
+// A failed/partial preparation or inference cannot establish a reusable pair.
+struct RifePairFailureGuard {
+    RifePairCache &cache;
+    bool complete = false;
+    ~RifePairFailureGuard() { if (!complete) cache.clear(); }
+};
