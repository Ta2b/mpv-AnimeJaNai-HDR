+RifeEncoderModels freeze_rife_encoder_models(const FrozenModel &source,const fs::path &cache)
+{
+    const auto folder=fs::u8path(source.directory);
+    const auto graph=read(folder/fs::u8path(source.name+".onnx"));
+    std::vector<std::string> locations;std::string why;
+    if(!aji_onnx_external_locations(graph,&locations,&why))throw std::runtime_error(why);
+    if(!locations.empty()||key(graph,folder,locations)!=source.content)
+        throw std::runtime_error("Shared encoder source snapshot changed or has external weights");
+    std::vector<char> encoder,head;
+    if(!aji_onnx_rife_encoder_split(graph,&encoder,&head,&why))throw std::runtime_error(why);
+    identity::Program p;p.source_scheme=source.scheme;p.source_digest=source.content;
+    p.converter="rife426-encoder-cut-wire";p.converter_version=1;
+    const auto recipe=identity::program_key(std::move(p));
+    const auto encoder_content=key(encoder,folder,{}),head_content=key(head,folder,{});
+    const auto destination=cache/recipe;const auto owner="rife-encoder:"+recipe;
+    auto complete=[&]{return valid(destination/"encoder",encoder_content,{})&&valid(destination/"head",head_content,{});};
+    auto result=[&]{return RifeEncoderModels{{encoder_content,(destination/"encoder").u8string(),"model"},
+                                           {head_content,(destination/"head").u8string(),"model"}};};
+    if(complete()&&!has_owned_stages(cache,".part-",owner))return result();
+    fs::create_directories(cache);KeyLock lock(cache/(recipe+".key-lock"));
+    recover_owned_stages(cache,".part-",owner);if(complete())return result();
+    Temporary stage{reserve(cache,".part-")};mark_stage(stage.path,owner);
+    const auto data=stage.path/"data";fs::create_directories(data/"encoder");fs::create_directory(data/"head");
+    for(const auto &part:{std::make_pair("encoder",&encoder),std::make_pair("head",&head)}) {
+        const auto path=data/part.first/"model.onnx";std::ofstream output(path,std::ios::binary);
+        output.write(part.second->data(),(std::streamsize)part.second->size());output.close();
+        if(!output)throw io_error("write shared RIFE encoder program",path);
+    }
+    if(!valid(data/"encoder",encoder_content,{})||!valid(data/"head",head_content,{}))
+        throw std::runtime_error("Shared RIFE programs incomplete");
+    if(fs::exists(destination)) {
+        auto quarantine=reserve(cache,".invalid-");std::error_code error;
+        fs::rename(destination,quarantine/"preserved",error);
+        if(error)throw io_error("preserve invalid shared RIFE programs",destination,error);
+    }
+    std::error_code error;fs::rename(data,destination,error);
+    if(error)throw io_error("publish shared RIFE programs",destination,error);
+    return result();
+}
