+// This converter deliberately supports one immutable source, not arbitrary ONNX.
+// Every retained node/initializer field is copied verbatim; only graph IO and
+// unreachable operations change. The five refinement warps stay in the head.
+bool aji_onnx_rife_encoder_split(const std::vector<char> &model,
+    std::vector<char> *encoder, std::vector<char> *head, std::string *why)
+{
+    constexpr const char *cut="/encode/cnn3/ConvTranspose_output_0";
+    aji::identity::Sha256 hash;hash.update(model.data(),model.size());
+    if(hash.hex()!="fd6b06538898c9a94d20f0fe55febceadbcde5ad64952240733b7275ef4c9d59") {
+        *why="shared RIFE encoder supports only the audited FP16 non-ensemble4.26 source";return false;
+    }
+    struct Field {uint32_t number;const uint8_t *start,*data,*end;size_t size;};
+    auto fields=[](const uint8_t *p,size_t size) {
+        std::vector<Field> result;Reader r{p,p+size};
+        while(r.p<r.end&&r.ok) {
+            const auto *start=r.p;uint32_t number;const uint8_t *data;size_t length;
+            if(!r.next(&number,&data,&length))break;
+            result.push_back({number,start,data,r.p,length});
+        }
+        if(!r.ok)throw std::runtime_error("malformed audited RIFE protobuf");return result;
+    };
+    auto text=[](const Field &f){return f.data?std::string((const char *)f.data,f.size):std::string();};
+    auto append=[](std::string &out,const Field &f){out.append((const char *)f.start,(const char *)f.end);};
+    auto entry=[](uint32_t number,const std::string &body){std::string out;put_varint(out,(uint64_t(number)<<3)|2);put_varint(out,body.size());return out+body;};
+    try {
+        const auto top=fields((const uint8_t *)model.data(),model.size());
+        const Field *graph=nullptr;for(const auto &f:top)if(f.number==7)graph=&f;
+        if(!graph||!graph->data)throw std::runtime_error("audited RIFE graph missing");
+        const auto body=fields(graph->data,graph->size);
+        std::vector<Node> nodes;std::vector<const Field *> node_fields;
+        std::map<std::string,size_t> producers;std::map<std::string,const Field *> weights;
+        const Field *input=nullptr,*output=nullptr;std::string input_name,output_name;
+        for(const auto &f:body) {
+            if(f.number==1) {
+                Node n;for(const auto &v:fields(f.data,f.size)) {
+                    if(v.number==1)n.in.push_back(text(v));
+                    if(v.number==2)n.out.push_back(text(v));
+                    if(v.number==4)n.op=text(v);
+                }
+                for(const auto &name:n.out)if(!producers.emplace(name,nodes.size()).second)
+                    throw std::runtime_error("duplicate RIFE tensor producer");
+                nodes.push_back(std::move(n));node_fields.push_back(&f);
+            } else if(f.number==5) {
+                for(const auto &v:fields(f.data,f.size))if(v.number==8)weights.emplace(text(v),&f);
+            } else if(f.number==11||f.number==12) {
+                if(f.number==11){if(input)throw std::runtime_error("multiple RIFE inputs");input=&f;}
+                else {if(output)throw std::runtime_error("multiple RIFE outputs");output=&f;}
+                for(const auto &v:fields(f.data,f.size))if(v.number==1)(f.number==11?input_name:output_name)=text(v);
+            }
+        }
+        if(!input||!output||input_name!="input"||output_name!="output"||!producers.count(cut))
+            throw std::runtime_error("audited RIFE IO changed");
+        std::vector<std::string> dimensions;
+        for(const auto &a:fields(input->data,input->size))if(a.number==2)
+            for(const auto &b:fields(a.data,a.size))if(b.number==1)
+                for(const auto &c:fields(b.data,b.size))if(c.number==2)
+                    for(const auto &d:fields(c.data,c.size))if(d.number==1)dimensions.push_back(std::string((const char *)d.start,(const char *)d.end));
+        if(dimensions.size()!=4)throw std::runtime_error("audited RIFE input is not rank4");
+        std::string shape=entry(1,std::string("\x08\x02",2))+entry(1,std::string("\x08\x04",2))+dimensions[2]+dimensions[3];
+        const std::string feature_info=entry(1,cut)+entry(2,entry(1,std::string("\x08\x0a",2)+entry(2,shape)));
+        auto extract=[&](bool encoding) {
+            std::set<size_t> selected;std::set<std::string> used_weights;
+            std::vector<std::string> pending{encoding?cut:output_name};
+            while(!pending.empty()) {
+                std::string name=std::move(pending.back());pending.pop_back();
+                if(name.empty()||name==input_name||(!encoding&&name==cut))continue;
+                const auto made=producers.find(name);
+                if(made==producers.end()) {
+                    if(!weights.count(name))throw std::runtime_error("RIFE tensor has no producer: "+name);
+                    used_weights.insert(name);continue;
+                }
+                if(selected.insert(made->second).second)
+                    for(const auto &source:nodes[made->second].in)pending.push_back(source);
+            }
+            int warps=0;for(auto i:selected)if(nodes[i].op=="GridSample")++warps;
+            if((encoding&&selected.size()!=11)||(!encoding&&warps!=5))throw std::runtime_error("RIFE encoder/refinement cut changed");
+            std::set<const Field *> selected_weights;for(const auto &name:used_weights)selected_weights.insert(weights.at(name));
+            std::string new_graph;size_t index=0;
+            for(const auto &f:body) {
+                if(f.number==1){if(selected.count(index))append(new_graph,f);++index;}
+                else if(f.number==5){if(selected_weights.count(&f))append(new_graph,f);}
+                else if(f.number==12){if(encoding)new_graph+=entry(12,feature_info);else append(new_graph,f);}
+                else append(new_graph,f);
+            }
+            if(!encoding)new_graph+=entry(11,feature_info);
+            std::string result;for(const auto &f:top)if(&f==graph)result+=entry(7,new_graph);else append(result,f);
+            return std::vector<char>(result.begin(),result.end());
+        };
+        auto a=extract(true),b=extract(false);*encoder=std::move(a);*head=std::move(b);return true;
+    }catch(const std::exception &e){*why=e.what();return false;}
+}
