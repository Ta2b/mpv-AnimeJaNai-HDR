#!/bin/sh
# AppImage entrypoint for AnimeJaNai.
#
# The AppImage mounts read-only (squashfs), but the runtime writes a lot:
# TensorRT engines build next to the ONNX, the filter writes the stats log, and
# the Manager edits animejanai.conf. So we mirror the *writable* parts of the
# tree into $XDG_DATA_HOME/AnimeJaNai-HDR-linux on first run (and re-seed managed files on
# version change), rewrite the config's paths to point at that writable dir, and
# run the bundled mpv against it. The read-only bits (mpv, libs, the inference
# runtime) stay in the mounted image.
set -eu

HERE="$(dirname "$(readlink -f "$0")")"

# Desktop integration. The menu entry and the "Open with" associations are registered
# automatically on a normal launch, and re-pointed when the AppImage was moved, renamed or
# replaced by a newer download. Nothing becomes the default player without being asked.
#   <AppImage> --install            register now (also undoes --uninstall)
#   <AppImage> --install --default  ...and make it the default video player
#   <AppImage> --uninstall          remove the entry and stop registering it
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/AnimeJaNai-HDR-linux"
APPS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
ICONS="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/256x256/apps"
desktop="$APPS/mpv-animejanai-hdr.desktop"
no_entry="$DATA/.no-desktop-entry"
MIMES="video/x-matroska;video/mp4;video/webm;video/x-msvideo;video/vnd.avi;video/avi;video/quicktime;video/mpeg;video/mp2t;video/x-flv;video/3gpp;video/ogg;video/x-ms-wmv;video/x-m4v;video/x-ogm+ogg;application/x-matroska;"

register_desktop() { # $1 = path the entry launches
    mkdir -p "$APPS" "$ICONS"
    [ -f "$HERE/mpv-animejanai.png" ] && cp -f "$HERE/mpv-animejanai.png" "$ICONS/mpv-animejanai-hdr.png"
    cat > "$desktop" <<EOF
[Desktop Entry]
Type=Application
Name=mpv AnimeJaNai HDR
GenericName=Media Player
Comment=Real-time anime upscaling video player (mpv + TensorRT)
Exec="$1" %U
TryExec=$1
Icon=mpv-animejanai-hdr
Terminal=false
Categories=AudioVideo;Player;Video;
MimeType=$MIMES
StartupNotify=true
EOF
    update-desktop-database "$APPS" 2>/dev/null || true
}

case "${1:-}" in
  --install|--uninstall)
    mkdir -p "$DATA"
    if [ "$1" = "--uninstall" ]; then
        rm -f "$desktop" "$ICONS/mpv-animejanai-hdr.png"
        : > "$no_entry"
        update-desktop-database "$APPS" 2>/dev/null || true
        echo "Removed the AnimeJaNai menu entry + file associations."
        echo "(cached engines/config in $DATA are kept; delete that folder to clear them)"
        exit 0
    fi
    target="${APPIMAGE:-$HERE}"
    [ -z "${APPIMAGE:-}" ] && echo "warning: \$APPIMAGE unset (run the .AppImage directly, not extracted); using $HERE" >&2
    rm -f "$no_entry"
    register_desktop "$target"
    if [ "${2:-}" = "--default" ]; then
        for m in $(echo "$MIMES" | tr ';' ' '); do
            [ -n "$m" ] && xdg-mime default mpv-animejanai-hdr.desktop "$m" 2>/dev/null || true
        done
        echo "Installed and set as the default video player."
    else
        echo "Installed: 'mpv AnimeJaNai HDR' now appears in your app menu and right-click > Open With."
        echo "(re-run with: --install --default  to also make it your default video player)"
    fi
    echo "  entry:    $desktop"
    echo "  launches: $target"
    exit 0
    ;;
esac

# Only a real AppImage registers itself ($APPIMAGE is set by its runtime), and only when the
# entry is missing or launches another file. A failure here must never prevent playback.
if [ -n "${APPIMAGE:-}" ] && [ ! -e "$no_entry" ] &&
   ! grep -qxF "TryExec=$APPIMAGE" "$desktop" 2>/dev/null; then
    register_desktop "$APPIMAGE" 2>/dev/null || true
fi

export ANIMEJANAI_APPIMAGE=1   # animejanai_update.lua and the updater: the AppImage file is replaced as a whole
mkdir -p "$DATA/portable_config" "$DATA/animejanai/onnx" "$DATA/animejanai/rife"

# Seed / refresh writable data. Managed files are overwritten on version change;
# user-owned files (animejanai.conf, mpv.conf, input.conf, engines) are kept.
VER_SRC="$HERE/version.txt"
VER_DST="$DATA/.seeded-version"
if [ ! -f "$VER_DST" ] || ! cmp -s "$VER_SRC" "$VER_DST" 2>/dev/null; then
    # user-preservable config: only copy if absent
    cp -rn "$HERE/portable_config/." "$DATA/portable_config/" 2>/dev/null || true
    # onnx models: engines build next to them, so they must be writable.
    # (RIFE models are fetched on demand below, not baked into the AppImage.)
    cp -rn "$HERE/animejanai/onnx/."  "$DATA/animejanai/onnx/"  2>/dev/null || true
    [ -f "$DATA/animejanai/animejanai.conf" ] || \
        cp -f "$HERE/animejanai/animejanai.conf" "$DATA/animejanai/animejanai.conf" 2>/dev/null || true
    cp -f "$VER_SRC" "$VER_DST" 2>/dev/null || true
fi

# Only files whose bytes still match an owned inventory are replaced/removed.
# Unknown files and local edits are preserved; the report names conflicts.
# Older trees without an inventory use the bounded known-source catalogue.
if ! "$HERE/AnimeJaNaiPlatform" --sync-managed-programs --package-root "$HERE" --root "$DATA" > "$DATA/.managed-program-sync.log" 2>&1; then
    echo "AnimeJaNai: programme sync incomplete; see $DATA/.managed-program-sync.log" >&2
fi
# Converted Vulkan models are managed assets and refresh even at the same version.
# TensorRT engine files and user banks remain writable and are preserved.
for model in "$HERE/animejanai/onnx/"*.ncnn.*; do
    [ -f "$model" ] && cp -f "$model" "$DATA/animejanai/onnx/"
done
if [ -d "$HERE/animejanai/rife-vulkan" ]; then
    cp -rf "$HERE/animejanai/rife-vulkan" "$DATA/animejanai/"
fi
# Banks and HDR settings are user-owned: seed missing files without overwriting edits.
cp -rn "$HERE/portable_config/profiles/." "$DATA/portable_config/profiles/" 2>/dev/null || true
# Refresh mpv-animejanai.conf from the image EVERY launch and repoint its paths.
# The AppImage mount path ($HERE) changes each run, so a once-rewritten conf would
# point at a dead mount. Inference libs come from the read-only image ($HERE);
# writable model/rife/conf/log live under $DATA. (mpv-animejanai.conf is a managed
# file, not user-edited, so overwriting it each launch is safe.)
# Managed files (lua scripts, shaders, the conf templates) are refreshed from
# the image EVERY launch - they're not user-edited, and version-gating them goes
# stale if a build reuses a version string.
cp -f  "$HERE/portable_config/input-animejanai.conf" "$DATA/portable_config/" 2>/dev/null || true
conf="$DATA/portable_config/mpv-animejanai.conf"
cp -f "$HERE/portable_config/mpv-animejanai.conf" "$conf" 2>/dev/null || true
if [ -f "$conf" ]; then
    sed -i \
        -e "s#~~/\.\./animejanai/inference#$HERE/animejanai/inference#g" \
        -e "s#~~/\.\./animejanai/onnx#$DATA/animejanai/onnx#g" \
        -e "s#~~/\.\./animejanai/rife#$DATA/animejanai/rife#g" \
        -e "s#~~/\.\./animejanai/animejanai.conf#$DATA/animejanai/animejanai.conf#g" \
        -e "s#~~/\.\./animejanai/currentanimejanai.log#$DATA/animejanai/currentanimejanai.log#g" \
        "$conf"
fi

# The Manager + updater binaries live in the read-only image, but the config's
# ~~/.. references resolve to $DATA. Symlink them into $DATA (re-linked every
# launch, since $HERE changes per run) so Ctrl+E and the update check find them.
for b in 7zz AnimeJaNaiManager-HDR AnimeJaNaiPlatform AnimeJaNaiManager AnimeJaNaiUpdater libSkiaSharp.so libHarfBuzzSharp.so; do
    [ -e "$HERE/$b" ] && ln -sf "$HERE/$b" "$DATA/$b"
done
# The Manager resolves its data dir relative to its exe by default; on the
# AppImage the exe is read-only, so point it at the writable tree. It inherits
# this env when mpv launches it via Ctrl+E.
# The updater resolves the same writable root for component installation.
cp -f "$HERE/version.txt" "$DATA/version.txt"
[ ! -f "$HERE/manifest.json" ] || cp -f "$HERE/manifest.json" "$DATA/manifest.json"
export ANIMEJANAI_DATA_DIR="$DATA/animejanai"
export ANIMEJANAI_ROOT="$DATA"
# The Manager reads the engine modules through links into this image; they dangle once the
# image is unmounted, so it falls back to the image itself when a data entry is missing.
export ANIMEJANAI_IMAGE_DIR="$HERE"
# The benchmark (clips, tool, launcher) stays in the image; the Manager's "Run Benchmarks"
# looks for it in the data folder and the results are written next to animejanai.conf.
if [ -d "$HERE/animejanai/benchmarks" ] && { [ -L "$DATA/animejanai/benchmarks" ] || [ ! -e "$DATA/animejanai/benchmarks" ]; }; then
    ln -sfn "$HERE/animejanai/benchmarks" "$DATA/animejanai/benchmarks"
fi

# Component packs fetched on demand into $DATA (writable). Like the Windows
# slim-install model, the AppImage carries no TensorRT component; the heavy,
# situational pieces are pulled only when actually needed. A fetch failure
# is non-fatal (e.g. offline, or a draft release whose assets need auth).
INFDATA="$DATA/animejanai/inference"
RIFEDATA="$DATA/animejanai/rife"
mkdir -p "$INFDATA" "$RIFEDATA"
# Links left by an earlier AppImage to files this one no longer carries (the TensorRT runtime
# became a pack): a pack is unpacked over them, and they would point into a gone mount.
find "$INFDATA" -maxdepth 1 -xtype l -delete 2>/dev/null || true
ver="$(cat "$HERE/version.txt" 2>/dev/null || echo "")"
relbase="https://github.com/Ta2b/mpv-AnimeJaNai-HDR/releases/download/${ver}"

# The version of one dependency in this AppImage's manifest (deps.KEY).
dep_of() {
    sed -n "s/^[[:space:]]*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$HERE/manifest.json" 2>/dev/null | head -1
}
# A pack fetched for another version of its dependency (a TensorRT or RIFE update, a new ONNX
# Runtime): it is fetched again. A pack installed before these marks existed counts as current.
pack_stale() { # $1 = pack, $2 = its dependency key
    want="$(dep_of "$2")"
    have="$(cat "$DATA/animejanai/.pack-$1" 2>/dev/null)"
    [ -n "$want" ] && [ -n "$have" ] && [ "$want" != "$have" ]
}
pack_mark() { # $1 = pack, $2 = its dependency key
    dep_of "$2" > "$DATA/animejanai/.pack-$1"
}

fetch_pack() { # $1 = pack base (e.g. trt-sm120, rife); $2 = human note; $3 = its dependency key
    pack="component-$1-linux-x64.7z"
    [ "${ANIMEJANAI_OFFLINE:-0}" = "1" ] && return 0
    { [ -n "$ver" ] && command -v curl >/dev/null 2>&1; } || return 0
    echo "AnimeJaNai: fetching $2 (one-time)..." >&2
    command -v notify-send >/dev/null 2>&1 && notify-send -a "mpv AnimeJaNai" "AnimeJaNai" "Téléchargement unique : $2. Le lecteur s'ouvre ensuite." 2>/dev/null || true
    # A pack that did not change since an earlier release is not published again: the index of
    # this release then gives the address it has in that earlier one.
    [ -n "${pack_index+x}" ] || pack_index="$(curl --connect-timeout 5 --max-time 30 -fsSL "$relbase/packs-linux-x64.json" 2>/dev/null | tr -d '\n')"
    pack_url="$(printf '%s' "$pack_index" | grep -o "\"url\"[[:space:]]*:[[:space:]]*\"[^\"]*/$pack\"" | head -1 | sed 's/.*"\(https[^"]*\)"$/\1/')"
    [ -n "$pack_url" ] || pack_url="$relbase/$pack"
    if curl --connect-timeout 5 --max-time 1800 -fSL "$pack_url" -o "$DATA/$pack"; then
        if "$HERE/7zz" x -snl -y -o"$DATA" "$DATA/$pack" >/dev/null 2>&1 && [ -n "${3:-}" ]; then
            pack_mark "$1" "$3"
        fi
        rm -f "$DATA/$pack"
    else
        rm -f "$DATA/$pack"
        echo "AnimeJaNai: could not fetch $pack (offline / draft release?)." >&2
    fi
}

# Refresh packaged library links before resolving the effective profile. Custom
# regular files remain untouched; the resolver records their actual presence.
for lib in "$HERE/animejanai/inference/"*; do
    [ -e "$lib" ] || continue
    dest="$INFDATA/$(basename "$lib")"
    if [ -L "$dest" ] || [ ! -e "$dest" ]; then ln -sf "$lib" "$dest"; fi
done
export LD_LIBRARY_PATH="$HERE/mpv:$HERE/animejanai/inference:$INFDATA:$HERE/usr/lib:${LD_LIBRARY_PATH:-}"

# The Manager and launchers use the same active-stage dependency contract.
# Resolve both required packs (for version refresh) and missing exact files.
# Failure is nonfatal: playback reports the detailed resolver error.
# Every profile Ctrl+1..9 can select counts. Before the player's first start no bank is active
# yet: the bank it is about to activate for this GPU is the one read.
components_conf="$DATA/animejanai/animejanai.conf"
if [ ! -f "$DATA/portable_config/profiles/active-bank.json" ]; then
    if nvidia-smi -L >/dev/null 2>&1; then first_bank=linux-nvidia; else first_bank=linux-amd; fi
    [ ! -f "$DATA/portable_config/profiles/$first_bank/animejanai.conf" ] || components_conf="$DATA/portable_config/profiles/$first_bank/animejanai.conf"
fi
profile_components="$("$DATA/AnimeJaNaiPlatform" --profile-components --all-slots --root "$DATA" --conf "$components_conf" 2>/dev/null || true)"
needs_component() { printf '%s\n' "$profile_components" | grep -q "^$1:"; }
missing_component() { printf '%s\n' "$profile_components" | grep -qx "$1:missing"; }

# Per-SM builder is needed only for a profile that actually uses TensorRT.
if needs_component trt-runtime; then
    sm="$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | head -1 | tr -d ' .')"
    if [ -n "$sm" ]; then
        [ ! -f "$INFDATA/libnvinfer.so.11" ] || [ -f "$DATA/animejanai/.pack-trt-runtime" ] || pack_mark trt-runtime inference_runtime
        if missing_component trt-runtime || pack_stale trt-runtime inference_runtime; then
            fetch_pack trt-runtime "TensorRT runtime (~260 MB)" inference_runtime
        fi
        if ls "$INFDATA"/libnvinfer_builder_resource_sm${sm}.so* >/dev/null 2>&1; then
            [ -f "$DATA/animejanai/.pack-trt-sm${sm}" ] || pack_mark "trt-sm${sm}" inference_runtime
        fi
        if ! ls "$INFDATA"/libnvinfer_builder_resource_sm${sm}.so* >/dev/null 2>&1 || pack_stale "trt-sm${sm}" inference_runtime; then
            fetch_pack "trt-sm${sm}" "TensorRT kernels for sm${sm} (~250 MB)" inference_runtime
        fi
    fi
fi
if needs_component rife; then
    if missing_component rife || pack_stale rife rife; then
        fetch_pack rife "Required RIFE interpolation models (~450 MB)" rife
    fi
fi
if needs_component onnxruntime; then
    [ ! -f "$INFDATA/libaji_ort.so" ] || [ -f "$DATA/animejanai/.pack-onnxruntime" ] || pack_mark onnxruntime onnxruntime
    if missing_component onnxruntime || pack_stale onnxruntime onnxruntime; then
        fetch_pack onnxruntime "ONNX Runtime engine with OpenVINO (~60 MB)" onnxruntime
    fi
fi

export LD_LIBRARY_PATH="$HERE/mpv:$HERE/animejanai/inference:$INFDATA:$HERE/usr/lib:${LD_LIBRARY_PATH:-}"
export ANIMEJANAI_MPV="$HERE/mpv/mpv"
# Downloaded components override image components (the matching runtime/builder share an ABI).
export ANIMEJANAI_INFERENCE_DIR="$INFDATA"
# AH-330: a regular file where the image provides a managed module is an old
# copy (a previous build kept by an update) unless the user declares it with a
# "<name>.override" marker. Old copies are renamed with a receipt, never deleted,
# so the engine actually loaded is the one the release declares.
migrations="$DATA/animejanai/managed-migrations.log"
# Only the modules the release declares (GPU-SOURCE.json digests) are migrated: files a
# component pack or a local test build installs under other names are left alone.
managed_names="$(grep -oE '"(lib[A-Za-z0-9_]+\.so|aji_pipeline\.fatbin)"' "$HERE/animejanai/inference/GPU-SOURCE.json" 2>/dev/null | tr -d '"' | sort -u | tr '\n' ' ')"
for lib in "$HERE/animejanai/inference/"*; do
    [ -e "$lib" ] || continue
    dest="$INFDATA/$(basename "$lib")"
    case " $managed_names " in *" $(basename "$lib") "*) managed=1;; *) managed=0;; esac
    if [ "$managed" = 1 ] && [ -e "$dest" ] && [ ! -L "$dest" ] && [ -f "$lib" ] && [ ! -e "$dest.override" ]; then
        if ! cmp -s "$lib" "$dest"; then
            stamp="$(date +%Y%m%d-%H%M%S)"
            if mv "$dest" "$dest.stale-$stamp.bak"; then
                printf '%s\t%s\trenamed stale regular file to %s (image provides %s)\n' "$(date -Is)" "$(basename "$dest")" "$(basename "$dest").stale-$stamp.bak" "$(sha256sum "$lib" | cut -c1-16)" >> "$migrations"
                echo "AnimeJaNai: old local copy of $(basename "$dest") renamed (see $migrations); add $(basename "$dest").override to keep a custom build" >&2
            fi
        fi
    fi
    if [ -L "$dest" ] || [ ! -e "$dest" ]; then ln -sf "$lib" "$dest"; fi
done
exec "$HERE/mpv-animejanai" "$@"
